# Supabase — projeto "monitor-candidatos" (org GLE TECH)
SUPABASE_URL=https://mjojuycrkxidpkzyzuuz.supabase.co

# Obrigatória para os coletores gravarem dados. As tabelas raw_payload e evento têm
# RLS habilitado sem policy pública de INSERT — só a service_role key (que ignora RLS)
# pode escrever. Pegue em: Supabase Dashboard > Project Settings > API > service_role.
# NUNCA exponha essa chave no frontend nem comite este arquivo preenchido.
# Sem ela, o worker falha na inicialização com um erro explicativo (não um crash confuso).
SUPABASE_SERVICE_ROLE_KEY=

# Câmara dos Deputados — API pública, não exige chave
CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2

# Opcional: id_camara padrão usado por `npm run collect:camara` quando --idCamara não é
# passado via linha de comando. O id_camara precisa já existir na tabela `candidato`.
CAMARA_ID_DEPUTADO=

# Portal da Transparência (CGU) — endpoints CEIS/CNEP, exige chave. Cadastre um e-mail
# gratuitamente em http://www.portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# para receber a chave (vai por e-mail). NUNCA comite este arquivo preenchido.
PORTAL_TRANSPARENCIA_API_KEY=
PORTAL_TRANSPARENCIA_API_BASE=https://api.portaldatransparencia.gov.br/api-de-dados

# Opcional: id_camara padrão usado por `npm run collect:transparencia` quando --idCamara
# não é passado via linha de comando (mesmo candidato-alvo, não precisa ser igual a
# CAMARA_ID_DEPUTADO). NUNCA defina um CPF aqui — --cpf é passado só na linha de comando,
# de propósito, para não deixar um CPF em claro sentado num arquivo .env (ver README do
# coletor em src/collectors/transparencia/README.md).
TRANSPARENCIA_ID_CAMARA=

# YouTube Data API v3 — exige chave (Google Cloud Console). Ver src/collectors/youtube/README.md.
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=
YOUTUBE_CANDIDATO_ID=
YOUTUBE_CHANNEL_ID=

# DataJud (CNJ) — exige chave (cadastro em https://datajud-wiki.cnj.jus.br/api-publica/acesso).
# Ver src/collectors/datajud/README.md — --numeroProcesso e --tribunal são passados só na
# linha de comando, nunca via .env.
DATAJUD_API_BASE=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=
